# PostgreSQL for VOLDECK's own tables (Prisma)
DATABASE_URL=postgres://voldeck:voldeck@localhost:5432/voldeck

# Redis (API response cache + worker caches)
REDIS_URL=redis://localhost:6379

# sim | live — ship with sim first, flip to live once sources are wired.
# The frontend's SIM DATA badge is bound to this flag (via /api/health + /api/overview).
DATA_MODE=sim

# GeckoTerminal (free tier, ~30 req/min)
GECKO_BASE=https://api.geckoterminal.com/api/v2

# Read-only connection string to the Robinfun Postgres (first-party RBH data).
# RBH live ingestion no-ops with a warning if empty.
ROBINFUN_DATABASE_URL=

API_PORT=4020

# CORS allowlist for the API (comma-separated). Leave empty in dev to allow all.
WEB_ORIGIN=https://voldeck.example.com
