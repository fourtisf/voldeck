generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VolumeBucket {
  id        BigInt   @id @default(autoincrement())
  chain     String // SOL | ETH | BSC | RBH
  tier      String // fine | coarse
  bucketTs  DateTime // bucket start, UTC-aligned
  volumeUsd Decimal  @db.Decimal(20, 2)
  txns      Int?

  @@unique([chain, tier, bucketTs])
  @@index([chain, tier, bucketTs(sort: Desc)])
}

model VenueVolume {
  id        BigInt   @id @default(autoincrement())
  chain     String
  venue     String // e.g. "Pump.fun", "Raydium", "PancakeSwap", "Four.meme", "Robinfun"
  ts        DateTime // hourly
  volumeUsd Decimal  @db.Decimal(20, 2)

  @@unique([chain, venue, ts])
}

model LaunchpadToken {
  id               BigInt    @id @default(autoincrement())
  chain            String
  venue            String
  symbol           String
  name             String
  category         String? // meme | ai | utility (best-effort in live mode)
  address          String? // on-chain token address (live mode; socials lookup key)
  mcUsd            Decimal?  @db.Decimal(20, 2)
  athMcUsd         Decimal?  @db.Decimal(20, 2) // max MC observed since tracking began
  startMcUsd       Decimal?  @db.Decimal(20, 2) // bonding-curve start MC where known
  vol24Usd         Decimal   @db.Decimal(20, 2)
  change24         Float?
  launchedAt       DateTime?
  websiteUrl       String?
  twitterUrl       String?
  telegramUrl      String?
  socialsCheckedAt DateTime? // null = token-info lookup still queued (live mode)
  updatedAt        DateTime  @updatedAt

  @@unique([chain, venue, symbol])
  @@index([chain, venue, vol24Usd(sort: Desc)])
}

model Alert {
  id      BigInt   @id @default(autoincrement())
  chain   String
  type    String // surge | fade | rotation
  message String
  ts      DateTime @default(now())

  @@index([ts(sort: Desc)])
  @@index([chain, ts(sort: Desc)])
}
